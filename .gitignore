# ====================================================================
# 1) LaTeX - Extraneous Intermediate Build Artifacts
# ====================================================================
# Core auxiliary files generated by latex/pdflatex/xelatex
*.aux
*.log
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)

# Bibliography and index files
*.bbl
*.blg
*.bcf
*.run.xml
*.idx
*.ind
*.ilg

# Additional common LaTeX document package overhead
*.out
*.lof
*.lot
*.nav
*.snm
*.vrb
*.dvi
*.xdv

# ====================================================================
# 2) Rust - Cargo Build Targets (Anywhere in the tree)
# ====================================================================
# Ignores the 'target' directory at the root or inside subdirectories
**/target/

# Backup files generated by Cargo when running fixes
**/*.rs.bk
